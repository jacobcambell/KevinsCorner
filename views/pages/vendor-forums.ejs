
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vendor Forums - Kevin's Corner</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .vendor-forums-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
        }

        .forum-header {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .forum-header h2 {
            margin: 0 0 10px 0;
            color: #333;
        }

        .forum-header p {
            margin: 0;
            color: #666;
        }

        .forum-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .threads-list {
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            overflow: hidden;
        }

        .thread-item {
            display: flex;
            align-items: center;
            padding: 15px 20px;
            border-bottom: 1px solid #e9ecef;
            transition: background-color 0.2s;
        }

        .thread-item:last-child {
            border-bottom: none;
        }

        .thread-item:hover {
            background-color: #f8f9fa;
        }

        .thread-badges {
            display: flex;
            gap: 5px;
            margin-right: 10px;
        }

        .badge {
            font-size: 12px;
            padding: 2px 6px;
            border-radius: 3px;
            font-weight: bold;
        }

        .badge-pinned {
            background: #28a745;
            color: white;
        }

        .badge-locked {
            background: #dc3545;
            color: white;
        }

        .thread-content {
            flex: 1;
        }

        .thread-title {
            font-weight: 600;
            color: #333;
            text-decoration: none;
            font-size: 16px;
        }

        .thread-title:hover {
            color: #007bff;
        }

        .thread-meta {
            font-size: 12px;
            color: #666;
            margin-top: 4px;
        }

        .thread-stats {
            text-align: right;
            color: #666;
            font-size: 12px;
            margin-left: 15px;
        }

        .no-threads {
            text-align: center;
            padding: 40px 20px;
            color: #666;
        }

        .vendor-only-notice {
            background: #e3f2fd;
            border: 1px solid #2196f3;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            color: #1976d2;
        }

        .vendor-only-notice strong {
            color: #0d47a1;
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: user }) %>

    <main>
        <%- include('../partials/vendor-nav') %>

        <div class="vendor-forums-container">
            <div class="forum-header">
                <h2>🏪 Vendor Forums</h2>
                <p>Private discussion area for verified vendors to share tips, ask questions, and collaborate.</p>
            </div>

            <div class="vendor-only-notice">
                <strong>🔒 Vendor Only:</strong> This is a private forum area accessible only to verified vendors. 
                Share experiences, discuss business strategies, and get help from fellow vendors.
            </div>

            <% if (error) { %>
                <div class="error"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="success"><%= success %></div>
            <% } %>

            <div class="forum-actions">
                <h3>Discussion Threads</h3>
                <a href="/vendor/forums/new-thread" class="btn btn-primary">📝 New Thread</a>
            </div>

            <div class="threads-list">
                <% if (threads && threads.length > 0) { %>
                    <% threads.forEach(thread => { %>
                        <div class="thread-item">
                            <div class="thread-badges">
                                <% if (thread.is_pinned === 1) { %>
                                    <span class="badge badge-pinned">📌 Pinned</span>
                                <% } %>
                                <% if (thread.is_locked === 1) { %>
                                    <span class="badge badge-locked">🔒 Locked</span>
                                <% } %>
                            </div>
                            
                            <div class="thread-content">
                                <a href="/vendor/forums/thread/<%= thread.id %>" class="thread-title">
                                    <%= thread.title %>
                                </a>
                                <div class="thread-meta">
                                    Started by <strong><%= thread.created_by_displayname %></strong> • 
                                    <%= new Date(thread.created_at).toLocaleDateString() %>
                                    <% if (thread.last_reply_at && thread.last_reply_at !== thread.created_at) { %>
                                        • Last reply: <%= new Date(thread.last_reply_at).toLocaleDateString() %>
                                    <% } %>
                                </div>
                            </div>
                            
                            <div class="thread-stats">
                                <div><%= thread.reply_count || 0 %> replies</div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="no-threads">
                        <h4>No threads yet</h4>
                        <p>Be the first to start a discussion!</p>
                        <a href="/vendor/forums/new-thread" class="btn btn-primary">Create First Thread</a>
                    </div>
                <% } %>
            </div>

            <div class="links" style="margin-top: 20px;">
                <a href="/vendor/dashboard">← Back to Dashboard</a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
