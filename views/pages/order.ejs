<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order <%= product.name %> - Kevin's Corner</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/header', { user: user }) %>

    <main>
        <div class="form-container">
            <h2>Place Order</h2>

            <% if (success) { %>
                <div class="success"><%= success %></div>
            <% } %>
            <% if (error) { %>
                <div class="error"><%= error %></div>
            <% } %>

            <div class="order-summary">
                <h3>Order Summary</h3>
                <div class="order-item">
                    <div class="item-image">
                        <% if (product.images && product.images.length > 0) { %>
                            <img src="<%= product.images[0] %>" alt="<%= product.name %>">
                        <% } else { %>
                            <div class="no-image-small">No Image</div>
                        <% } %>
                    </div>
                    <div class="item-details">
                        <h4><%= product.name %></h4>
                        <p class="item-type"><%= product.product_type.charAt(0).toUpperCase() + product.product_type.slice(1) %> Product</p>
                        <p class="item-vendor">Sold by: <%= product.vendor_name %></p>
                        <div class="item-price">
                            <span class="currency"><%= product.currency || 'USD' %></span>
                            <span class="amount">$<%= parseFloat(product.price).toFixed(2) %></span>
                            <% if (typeof xmrPrice !== 'undefined' && xmrPrice) { %>
                                <div class="xmr-price">≈ <%= ((parseFloat(product.price) / xmrPrice) * 1.07).toFixed(7) %> XMR</div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <form action="/products/<%= product.id %>/order" method="POST" class="order-form">
                <div class="form-group">
                    <label for="quantity">Quantity:</label>
                    <input type="number" id="quantity" name="quantity" value="1" min="1" max="10" required>
                </div>

                <div class="form-group">
                    <label for="paymentMethod">Payment Method:</label>
                    <select id="paymentMethod" name="paymentMethod" required>
                        <option value="XMR">Monero (XMR)</option>
                        <option value="BTC" disabled>Bitcoin (BTC) - Coming Soon</option>
                        <option value="ETH" disabled>Ethereum (ETH) - Coming Soon</option>
                    </select>
                </div>

                <div class="order-total">
                    <div class="total-line">
                        <span>Subtotal:</span>
                        <span id="subtotal">$<%= parseFloat(product.price).toFixed(2) %></span>
                    </div>
                    <div class="total-line">
                        <span>Payment Method:</span>
                        <span>Monero (XMR)</span>
                    </div>
                    <div class="total-line total-final">
                        <span><strong>Total:</strong></span>
                        <span id="total"><strong>$<%= parseFloat(product.price).toFixed(2) %></strong></span>
                    </div>
                </div>

                <div class="vendor-reviews-section">
                    <h4>Vendor Reviews</h4>
                    <% if (product.vendor_rating && product.rating_count > 0) { %>
                        <div class="vendor-overall-rating">
                            <div class="rating-display">
                                <span class="rating-stars">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <span class="star <%= i <= Math.round(product.vendor_rating) ? 'filled' : '' %>">★</span>
                                    <% } %>
                                </span>
                                <span class="rating-text"><%= product.vendor_rating %> out of 5 (<%= product.rating_count %> review<%= product.rating_count === 1 ? '' : 's' %>)</span>
                            </div>
                        </div>
                    <% } %>

                    <% if (vendorFeedback && vendorFeedback.length > 0) { %>
                        <div class="recent-reviews">
                            <h5>Recent Reviews:</h5>
                            <% vendorFeedback.forEach(function(feedback) { %>
                                <div class="review-item">
                                    <div class="review-header">
                                        <div class="review-rating">
                                            <% for (let i = 1; i <= 5; i++) { %>
                                                <span class="star <%= i <= feedback.rating ? 'filled' : '' %>">★</span>
                                            <% } %>
                                        </div>
                                        <div class="review-meta">
                                            <span class="reviewer-name"><%
                                                const displayName = feedback.buyer_name || feedback.buyer_username;
                                                if (displayName && displayName.length > 2) {
                                                    const censored = displayName.charAt(0) + '*'.repeat(Math.max(0, displayName.length - 2)) + displayName.charAt(displayName.length - 1);
                                                %>
                                                <%= censored %>
                                                <%
                                                } else {
                                                %>
                                                <%= displayName || 'Anonymous' %>
                                                <%
                                                }
                                            %></span>
                                            <span class="review-date"><%= new Date(feedback.created_at).toLocaleDateString() %></span>
                                        </div>
                                    </div>
                                    <% if (feedback.feedback_text) { %>
                                        <div class="review-text">
                                            "<%= feedback.feedback_text %>"
                                        </div>
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="no-reviews">
                            <p>No reviews yet for this vendor.</p>
                        </div>
                    <% } %>
                </div>

                <div class="order-notes">
                    <h4>Order Notes:</h4>
                    <ul>
                        <li>Orders are processed manually by the vendor</li>
                        <li>You will receive payment instructions after placing the order</li>
                        <li><% if (product.product_type === 'digital') { %>Digital products will be delivered after payment confirmation<% } else { %>Physical products will be shipped after payment confirmation<% } %></li>
                        <li>All transactions are final - no refunds</li>
                    </ul>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-large">Place Order</button>
                    <a href="/products/<%= product.id %>" class="btn btn-secondary">← Back to Product</a>
                </div>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script>
        const basePrice = <%= parseFloat(product.price) %>;
        const quantityInput = document.getElementById('quantity');
        const subtotalElement = document.getElementById('subtotal');
        const totalElement = document.getElementById('total');

        function updateTotal() {
            const quantity = parseInt(quantityInput.value) || 1;
            const subtotal = basePrice * quantity;

            subtotalElement.textContent = '$' + subtotal.toFixed(2);
            totalElement.innerHTML = '<strong>$' + subtotal.toFixed(2) + '</strong>';
        }

        quantityInput.addEventListener('input', updateTotal);
    </script>
</body>
</html>