
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= thread.title %> - Vendor Forums - Kevin's Corner</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .thread-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
        }

        .thread-header {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .thread-title {
            margin: 0 0 10px 0;
            color: #333;
            font-size: 24px;
        }

        .thread-meta {
            color: #666;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .thread-badges {
            display: flex;
            gap: 5px;
            margin-top: 10px;
        }

        .badge {
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
            padding: 2px 6px;
            border-radius: 3px;
        }

        .badge-pinned {
            background: #28a745;
            color: white;
        }

        .badge-locked {
            background: #dc3545;
            color: white;
        }

        .post-container {
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            margin-bottom: 15px;
            overflow: hidden;
        }

        .post-header {
            background: #f8f9fa;
            padding: 12px 20px;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .post-author {
            font-weight: 600;
            color: #333;
        }

        .post-date {
            color: #666;
            font-size: 12px;
        }

        .post-content {
            padding: 20px;
            line-height: 1.6;
            color: #333;
        }

        .original-post {
            border-left: 4px solid #007bff;
        }

        .original-post .post-header {
            background: #e7f3ff;
        }

        .op-badge {
            background: #007bff;
            color: white;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: bold;
            margin-left: 8px;
        }

        .reply-form {
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
        }

        .reply-form h3 {
            margin: 0 0 15px 0;
            color: #333;
        }

        .reply-form textarea {
            width: 100%;
            min-height: 120px;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-family: inherit;
            font-size: 14px;
            resize: vertical;
            box-sizing: border-box;
        }

        .reply-form textarea:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.25);
        }

        .reply-actions {
            margin-top: 15px;
            display: flex;
            justify-content: flex-end;
        }

        .locked-notice {
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            margin-top: 20px;
            color: #721c24;
        }

        .breadcrumb {
            margin-bottom: 20px;
            font-size: 14px;
            color: #666;
        }

        .breadcrumb a {
            color: #007bff;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .vendor-indicator {
            background: #28a745;
            color: white;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: bold;
            margin-left: 8px;
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: user }) %>

    <main>
        <%- include('../partials/vendor-nav') %>

        <div class="thread-container">
            <div class="breadcrumb">
                <a href="/vendor/forums">🏪 Vendor Forums</a> › <%= thread.title %>
            </div>

            <div class="thread-header">
                <h1 class="thread-title"><%= thread.title %></h1>
                
                <div class="thread-meta">
                    Started by <strong><%= thread.created_by_displayname %></strong> • 
                    <%= new Date(thread.created_at).toLocaleDateString() %> • 
                    <%= posts ? posts.length : 0 %> replies
                </div>

                <% if (thread.is_pinned === 1 || thread.is_locked === 1) { %>
                    <div class="thread-badges">
                        <% if (thread.is_pinned === 1) { %>
                            <span class="badge badge-pinned">📌 Pinned</span>
                        <% } %>
                        <% if (thread.is_locked === 1) { %>
                            <span class="badge badge-locked">🔒 Locked</span>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <% if (error) { %>
                <div class="error"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="success"><%= success %></div>
            <% } %>

            <!-- Original Post -->
            <div class="post-container original-post">
                <div class="post-header">
                    <div>
                        <span class="post-author"><%= thread.created_by_displayname %></span>
                        <span class="op-badge">OP</span>
                        <span class="vendor-indicator">VENDOR</span>
                    </div>
                    <div class="post-date"><%= new Date(thread.created_at).toLocaleString() %></div>
                </div>
                <div class="post-content">
                    <%- thread.content.replace(/\n/g, '<br>') %>
                </div>
            </div>

            <!-- Replies -->
            <% if (posts && posts.length > 0) { %>
                <% posts.forEach(post => { %>
                    <div class="post-container">
                        <div class="post-header">
                            <div>
                                <span class="post-author"><%= post.created_by_displayname %></span>
                                <span class="vendor-indicator">VENDOR</span>
                            </div>
                            <div class="post-date"><%= new Date(post.created_at).toLocaleString() %></div>
                        </div>
                        <div class="post-content">
                            <%- post.content.replace(/\n/g, '<br>') %>
                        </div>
                    </div>
                <% }) %>
            <% } %>

            <!-- Reply Form -->
            <% if (thread.is_locked === 1) { %>
                <div class="locked-notice">
                    🔒 This thread is locked. No new replies can be added.
                </div>
            <% } else { %>
                <div class="reply-form">
                    <h3>💬 Post a Reply</h3>
                    <form action="/vendor/forums/thread/<%= thread.id %>/reply" method="POST">
                        <textarea name="content" placeholder="Share your thoughts, experiences, or advice with fellow vendors..." required></textarea>
                        <div class="reply-actions">
                            <button type="submit" class="btn btn-primary">🚀 Post Reply</button>
                        </div>
                    </form>
                </div>
            <% } %>

            <div class="links" style="margin-top: 20px;">
                <a href="/vendor/forums">← Back to Vendor Forums</a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
