
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vendor Dashboard - Kevin's Corner</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #1a252f, #2c3e50);
            color: white;
            padding: 30px;
            border-radius: 10px;
            margin-bottom: 30px;
            text-align: center;
        }

        .dashboard-header h1 {
            margin: 0 0 10px 0;
            font-size: 2.5rem;
        }

        .dashboard-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 1.1rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            text-align: center;
            border-left: 5px solid #007bff;
        }

        .stat-card.revenue {
            border-left-color: #28a745;
        }

        .stat-card.orders {
            border-left-color: #007bff;
        }

        .stat-card.products {
            border-left-color: #ffc107;
        }

        .stat-card.rating {
            border-left-color: #dc3545;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #666;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-sublabel {
            color: #999;
            font-size: 0.8rem;
            margin-top: 5px;
        }

        .charts-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        .chart-container {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .chart-container h3 {
            margin: 0 0 20px 0;
            color: #333;
            font-size: 1.3rem;
        }

        .chart-canvas {
            position: relative;
            height: 300px;
        }

        .tables-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .table-container {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .table-container h3 {
            margin: 0 0 20px 0;
            color: #333;
            font-size: 1.3rem;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th,
        .data-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        .data-table th {
            background: #f8f9fa;
            font-weight: 600;
            color: #555;
        }

        .data-table tr:hover {
            background: #f8f9fa;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-completed {
            background: #d4edda;
            color: #155724;
        }

        .status-shipped {
            background: #d1ecf1;
            color: #0c5460;
        }

        .no-data {
            text-align: center;
            color: #666;
            font-style: italic;
            padding: 20px;
        }

        @media (max-width: 768px) {
            .charts-grid {
                grid-template-columns: 1fr;
            }
            
            .tables-grid {
                grid-template-columns: 1fr;
            }
            
            .stats-grid {
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: user }) %>
    <%- include('../partials/vendor-nav') %>

    <main>
        <div class="dashboard-container">
            <div class="dashboard-header">
                <h1>📊 Vendor Dashboard</h1>
                <p>Welcome back, <%= vendor.business_name %>! Here's your business overview.</p>
            </div>

            <% if (error) { %>
                <div class="error"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="success"><%= success %></div>
            <% } %>

            <!-- Key Statistics -->
            <div class="stats-grid">
                <div class="stat-card revenue">
                    <div class="stat-number">$<%= (analytics.sales.total_revenue || 0).toFixed(2) %></div>
                    <div class="stat-label">Total Revenue</div>
                    <div class="stat-sublabel">$<%= (analytics.sales.pending_revenue || 0).toFixed(2) %> pending</div>
                </div>
                
                <div class="stat-card orders">
                    <div class="stat-number"><%= analytics.sales.total_orders || 0 %></div>
                    <div class="stat-label">Total Orders</div>
                    <div class="stat-sublabel"><%= analytics.sales.pending_orders || 0 %> pending</div>
                </div>
                
                <div class="stat-card products">
                    <div class="stat-number"><%= analytics.productStats.active_products || 0 %></div>
                    <div class="stat-label">Active Products</div>
                    <div class="stat-sublabel"><%= analytics.productStats.total_products || 0 %> total products</div>
                </div>
                
                <div class="stat-card rating">
                    <div class="stat-number">
                        <% if (analytics.rating.avg_rating > 0) { %>
                            <%= analytics.rating.avg_rating %>⭐
                        <% } else { %>
                            N/A
                        <% } %>
                    </div>
                    <div class="stat-label">Average Rating</div>
                    <div class="stat-sublabel"><%= analytics.rating.rating_count || 0 %> reviews</div>
                </div>
            </div>

            <!-- Charts -->
            <div class="charts-grid">
                <div class="chart-container">
                    <h3>📈 Revenue Trend (Last 12 Months)</h3>
                    <div class="chart-canvas">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
                
                <div class="chart-container">
                    <h3>🏷️ Product Performance</h3>
                    <div class="chart-canvas">
                        <canvas id="productChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Data Tables -->
            <div class="tables-grid">
                <div class="table-container">
                    <h3>🔥 Top Selling Products</h3>
                    <% if (analytics.products && analytics.products.length > 0) { %>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Sales</th>
                                    <th>Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% analytics.products.slice(0, 5).forEach(product => { %>
                                    <tr>
                                        <td><%= product.name %></td>
                                        <td><%= product.sales_count || 0 %></td>
                                        <td>$<%= (product.total_sales || 0).toFixed(2) %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="no-data">No sales data available yet</div>
                    <% } %>
                </div>
                
                <div class="table-container">
                    <h3>📦 Recent Orders</h3>
                    <% if (analytics.recent && analytics.recent.length > 0) { %>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% analytics.recent.slice(0, 5).forEach(order => { %>
                                    <tr>
                                        <td>#<%= order.id %></td>
                                        <td>
                                            <span class="status-badge status-<%= order.status %>">
                                                <%= order.status %>
                                            </span>
                                        </td>
                                        <td>$<%= order.total_price.toFixed(2) %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="no-data">No recent orders</div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Revenue Trend Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        const monthlyData = <%- JSON.stringify(analytics.monthly) %>;
        
        // Prepare last 12 months data
        const months = [];
        const revenues = [];
        const now = new Date();
        
        for (let i = 11; i >= 0; i--) {
            const date = new Date(now.getFullYear(), now.getMonth() - i, 1);
            const monthKey = date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0');
            months.push(date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }));
            
            const monthData = monthlyData.find(m => m.month === monthKey);
            revenues.push(monthData ? monthData.revenue : 0);
        }

        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: months,
                datasets: [{
                    label: 'Revenue ($)',
                    data: revenues,
                    borderColor: '#007bff',
                    backgroundColor: 'rgba(0, 123, 255, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '$' + value;
                            }
                        }
                    }
                }
            }
        });

        // Product Performance Chart
        const productCtx = document.getElementById('productChart').getContext('2d');
        const productData = <%- JSON.stringify(analytics.products) %>;
        
        const topProducts = productData.slice(0, 5);
        const productNames = topProducts.map(p => p.name.length > 15 ? p.name.substring(0, 15) + '...' : p.name);
        const productSales = topProducts.map(p => p.sales_count || 0);

        new Chart(productCtx, {
            type: 'doughnut',
            data: {
                labels: productNames,
                datasets: [{
                    data: productSales,
                    backgroundColor: [
                        '#007bff',
                        '#28a745',
                        '#ffc107',
                        '#dc3545',
                        '#6c757d'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>

    <%- include('../partials/footer') %>
</body>
</html>
