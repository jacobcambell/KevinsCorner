<!DOCTYPE html>
<html>
<head>
    <title>Forum Categories - Admin Panel - Kevin's Corner</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Kevin's Corner - Admin Panel</h1>
        <div style="float: right;">
            Welcome, <%= user.displayname %>! 
            <form method="POST" action="/auth/logout" style="display: inline;">
                <button type="submit" style="background: none; border: none; color: white; cursor: pointer; text-decoration: underline;">Logout</button>
            </form>
        </div>
    </header>

    <main>
        <div class="admin-panel">
            <h2>Forum Categories Management</h2>

            <div class="admin-nav">
                <nav>
                    <ul>
                        <li><a href="/admin/dashboard">← Back to Dashboard</a></li>
                        <li><a href="/admin/users">Manage Users</a></li>
                        <li><a href="/admin/support">Support Messages</a></li>
                        <li><a href="/forums">View Forums</a></li>
                    </ul>
                </nav>
            </div>

            <% if (error) { %>
                <div class="error"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="success"><%= success %></div>
            <% } %>

            <!-- Add New Category Form -->
            <div class="form-container">
                <h3>Add New Forum Category</h3>
                <form action="/admin/forum-categories/add" method="POST">
                    <div class="form-group">
                        <label for="name">Category Name:</label>
                        <input type="text" id="name" name="name" required maxlength="100">
                    </div>

                    <div class="form-group">
                        <label for="description">Description (optional):</label>
                        <textarea id="description" name="description" rows="3" maxlength="500"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Create Category</button>
                </form>
            </div>

            <!-- Existing Categories -->
            <div class="categories-list">
                <h3>Existing Forum Categories</h3>
                <% if (categories.length > 0) { %>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>Threads</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% categories.forEach(category => { %>
                                <tr>
                                    <td><%= category.id %></td>
                                    <td>
                                        <strong><%= category.name %></strong>
                                    </td>
                                    <td><%= category.description || 'No description' %></td>
                                    <td>
                                        <span class="stat-badge"><%= category.thread_count %> threads</span>
                                    </td>
                                    <td><%= new Date(category.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <div class="action-buttons">
                                            <a href="/forums/category/<%= category.id %>" class="btn btn-small btn-secondary">View</a>
                                            <% if (category.thread_count === 0) { %>
                                                <form method="POST" action="/admin/forum-categories/<%= category.id %>/delete" 
                                                      style="display: inline;" 
                                                      onsubmit="return confirm('Are you sure you want to delete this category?')">
                                                    <button type="submit" class="btn btn-small btn-danger">Delete</button>
                                                </form>
                                            <% } else { %>
                                                <button class="btn btn-small btn-danger" disabled title="Cannot delete category with threads">Delete</button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="empty-state">
                        <p>No forum categories found.</p>
                        <p>Create the first category using the form above.</p>
                    </div>
                <% } %>
            </div>

            <!-- Forum Banners Management -->
            <div class="banners-section">
                <h3>Forum Banner Management</h3>

                <!-- Add New Banner Form -->
                <div class="form-container">
                    <h4>Add New Forum Banner</h4>
                    <form action="/admin/forum-banners/add" method="POST" style="margin-top: 20px;" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="bannerTitle">Banner Title:</label>
                        <input type="text" id="bannerTitle" name="title" required>
                    </div>

                    <div class="form-group">
                        <label for="bannerImage">Upload Image:</label>
                        <input type="file" id="bannerImage" name="banner_image" accept="image/*" required>
                        <div id="imagePreview" style="margin-top: 10px; max-width: 200px; border: 2px dashed #ddd; min-height: 100px; display: flex; align-items: center; justify-content: center; color: #666;">
                            No image selected
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="bannerLink">Link URL (optional):</label>
                        <input type="url" id="bannerLink" name="link_url">
                    </div>

                    <div class="form-group">
                        <label for="bannerKeywords">Keywords (for search):</label>
                        <input type="text" id="bannerKeywords" name="keywords" placeholder="e.g. gaming, retro, 90s, fun">
                        <div class="help-text">Comma-separated keywords to help users find this banner through search</div>
                    </div>

                    <div class="form-group">
                        <label for="bannerOrder">Display Order:</label>
                        <input type="number" id="bannerOrder" name="display_order" value="0" min="0">
                    </div>

                    <button type="submit" class="btn btn-primary">Add Banner</button>
                </form>

                <script>
                document.getElementById('bannerImage').addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    const preview = document.getElementById('imagePreview');

                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            preview.innerHTML = '<img src="' + e.target.result + '" style="max-width: 100%; max-height: 150px; border: 1px solid #ddd;">';
                        };
                        reader.readAsDataURL(file);
                    } else {
                        preview.innerHTML = 'No image selected';
                    }
                });
                </script>
                </div>

                <!-- Existing Banners -->
                <div class="banners-list">
                    <h4>Current Forum Banners</h4>
                    <div id="banners-container">
                        <!-- Banners will be loaded here -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Website Directory Management -->
        <div class="website-directory-management">
            <h2>Website Directory Management</h2>

            <!-- Add New Website Form -->
            <div class="form-container">
                <h3>Add Website to Directory</h3>
                <form action="/admin/website-directory/add" method="POST">
                    <div class="form-group">
                        <label for="websiteTitle">Website Title:</label>
                        <input type="text" id="websiteTitle" name="title" placeholder="Google" required>
                    </div>

                    <div class="form-group">
                        <label for="websiteUrl">Website URL:</label>
                        <input type="url" id="websiteUrl" name="url" placeholder="https://google.com" required>
                    </div>

                    <div class="form-group">
                        <label for="websiteKeywords">Keywords (comma-separated):</label>
                        <input type="text" id="websiteKeywords" name="keywords" placeholder="search engine, google, web search" required>
                    </div>

                    <div class="form-group">
                        <label for="websiteDescription">Description (optional):</label>
                        <textarea id="websiteDescription" name="description" rows="3" placeholder="Popular search engine"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Add Website</button>
                </form>
            </div>

            <!-- Existing Websites List -->
            <div class="websites-list">
                <h3>Existing Websites</h3>
                <% if (websites && websites.length > 0) { %>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>URL</th>
                                <th>Keywords</th>
                                <th>Status</th>
                                <th>Added</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% websites.forEach(website => { %>
                                <tr>
                                    <td><%= website.title %></td>
                                    <td>
                                        <a href="<%= website.url %>" target="_blank" rel="noopener noreferrer">
                                            <%= website.url.length > 30 ? website.url.substring(0, 30) + '...' : website.url %>
                                        </a>
                                    </td>
                                    <td><%= website.keywords %></td>
                                    <td>
                                        <span class="status-badge <%= website.is_active ? 'active' : 'inactive' %>">
                                            <%= website.is_active ? 'Active' : 'Inactive' %>
                                        </span>
                                    </td>
                                    <td><%= new Date(website.created_at).toLocaleDateString() %></td>
                                    <td class="action-buttons">
                                        <form action="/admin/website-directory/<%= website.id %>/toggle" method="POST" style="display: inline;">
                                            <button type="submit" class="btn btn-small <%= website.is_active ? 'btn-secondary' : 'btn-success' %>">
                                                <%= website.is_active ? 'Deactivate' : 'Activate' %>
                                            </button>
                                        </form>
                                        <form action="/admin/website-directory/<%= website.id %>/delete" method="POST" style="display: inline;" 
                                              onsubmit="return confirm('Are you sure you want to delete this website?')">
                                            <button type="submit" class="btn btn-small btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="empty-state">
                        <p>No websites in directory yet</p>
                        <p>Add some websites above to get started!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>