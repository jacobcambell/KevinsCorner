
<!DOCTYPE html>
<html>
<head>
    <title>My Support Messages - Kevin's Corner</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            background: #1a1a1a;
            color: #e0e0e0;
        }
        
        .support-messages-container {
            background: #2d2d2d;
            border: 2px solid #444;
            border-radius: 12px;
            padding: 30px;
        }
        
        .support-messages-container h2 {
            color: #e0e0e0;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 25px;
        }
        
        .message-card {
            background: #1a1a1a;
            border: 2px solid #444;
            color: #e0e0e0;
        }
        
        .message-header h3 {
            color: #e0e0e0 !important;
            font-size: 1.3rem;
            font-weight: 700;
        }
        
        .message-content {
            color: #b0b0b0;
            font-size: 1rem;
            line-height: 1.6;
        }
        
        .original-message {
            background: #0d1a2d;
            border-left: 4px solid #007bff;
            color: #e0e0e0;
        }
        
        .original-message p {
            color: #e0e0e0;
            font-size: 1rem;
            font-weight: 500;
        }
        
        .original-message strong {
            color: #66b3ff;
            font-weight: 700;
        }
        
        .thread-reply {
            background: #1a1a1a;
            border: 2px solid #444;
            border-radius: 8px;
            padding: 16px;
            margin: 10px 0;
        }
        
        .admin-reply {
            border-color: #28a745;
            background: #0d2818;
        }
        
        .admin-reply .reply-header strong {
            color: #4caf50;
            font-size: 1.1rem;
        }
        
        .admin-reply p {
            color: #e0e0e0;
            font-size: 1rem;
        }
        
        .user-reply {
            border-color: #007bff;
            background: #0d1a2d;
        }
        
        .user-reply .reply-header strong {
            color: #66b3ff;
            font-size: 1.1rem;
        }
        
        .user-reply p {
            color: #e0e0e0;
            font-size: 1rem;
        }
        
        .reply-header {
            margin-bottom: 10px;
        }
        
        .reply-timestamp, .message-timestamp {
            color: #888;
            font-size: 0.9rem;
        }
        
        .message-date {
            color: #b0b0b0;
            font-size: 1rem;
            font-weight: 500;
        }
        
        .reply-form h4 {
            color: #e0e0e0;
            font-size: 1.2rem;
            font-weight: 600;
        }
        
        .reply-form textarea {
            background: #1a1a1a;
            border: 2px solid #444;
            color: #e0e0e0;
            font-size: 1rem;
        }
        
        .closed-notice p {
            color: #f56565;
            font-size: 1rem;
            font-weight: 600;
        }
        
        .message-thread h4 {
            color: #e0e0e0;
            font-size: 1.2rem;
            font-weight: 600;
        }
        
        .links a {
            color: #66b3ff;
            font-size: 1rem;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <header>
        <h1>Kevin's Corner</h1>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/support/contact">Contact Support</a></li>
            </ul>
        </nav>
        <div style="float: right;">
            Welcome, <%= user.displayname %>! 
            <form method="POST" action="/auth/logout" style="display: inline;">
                <button type="submit" style="background: none; border: none; color: white; cursor: pointer; text-decoration: underline;">Logout</button>
            </form>
        </div>
    </header>

    <main>
        <div class="support-messages-container">
            <h2>My Support Messages</h2>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error"><%= error %></div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="success"><%= success %></div>
            <% } %>
            
            <% if (messages.length > 0) { %>
                <div class="messages-list">
                    <% messages.forEach(message => { %>
                        <div class="message-card">
                            <div class="message-header">
                                <h3><%= message.subject %></h3>
                                <span class="status-badge <%= message.status %>"><%= message.status %></span>
                                <span class="message-date"><%= new Date(message.created_at).toLocaleDateString() %></span>
                            </div>
                            
                            <div class="message-content">
                                <div class="original-message">
                                    <p><strong>Your Original Message:</strong></p>
                                    <p><%= message.message %></p>
                                    <small class="message-timestamp">Sent: <%= new Date(message.created_at).toLocaleString() %></small>
                                </div>
                                
                                <!-- Thread Replies -->
                                <% if (message.replies && message.replies.length > 0) { %>
                                    <div class="message-thread">
                                        <h4>Conversation:</h4>
                                        <% message.replies.forEach(reply => { %>
                                            <div class="thread-reply <%= reply.sender_type %>-reply">
                                                <div class="reply-header">
                                                    <strong>
                                                        <% if (reply.sender_type === 'admin') { %>
                                                            🛠️ Admin (<%= reply.sender_name %>)
                                                        <% } else { %>
                                                            👤 You
                                                        <% } %>
                                                    </strong>
                                                    <small class="reply-timestamp"><%= new Date(reply.created_at).toLocaleString() %></small>
                                                </div>
                                                <p><%= reply.reply_text %></p>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } %>
                                
                                <!-- Reply Form (only if not closed) -->
                                <% if (message.status !== 'closed') { %>
                                    <div class="reply-form">
                                        <h4>Add Reply:</h4>
                                        <form method="POST" action="/support/messages/<%= message.id %>/reply">
                                            <div class="form-group">
                                                <textarea name="reply_text" placeholder="Type your reply..." rows="3" required></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-small">Send Reply</button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <div class="closed-notice">
                                        <p><em>This conversation has been closed.</em></p>
                                    </div>
                                <% } %>
                                
                                <!-- Delete Message Form -->
                                <div class="message-delete">
                                    <form method="POST" action="/support/messages/<%= message.id %>/delete" 
                                          onsubmit="return confirm('Are you sure you want to delete this message? This action cannot be undone.')">
                                        <button type="submit" class="btn btn-small btn-danger">Delete Message</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p>No messages found. <a href="/support/contact">Contact Support</a> to send your first message.</p>
            <% } %>
            
            <div class="links">
                <a href="/">← Back to Home</a> | 
                <a href="/support/contact">Send New Message</a>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
