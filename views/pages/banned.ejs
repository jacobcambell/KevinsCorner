
<!DOCTYPE html>
<html>
<head>
    <title>Account Banned - Kevin's Corner</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Kevin's Corner</h1>
    </header>

    <main>
        <div class="banned-container">
            <div class="banned-message">
                <h2>🚫 Account Banned</h2>
                <p>Your account has been banned from Kevin's Corner.</p>
                
                <% if (banReason) { %>
                    <div class="ban-details">
                        <h3>Reason:</h3>
                        <p class="ban-reason"><%= banReason %></p>
                    </div>
                <% } %>
                
                <div class="banned-info">
                    <p>If you believe this is an error, please contact the administrator.</p>
                    <p>You will be automatically logged out in <span id="countdown">10</span> seconds.</p>
                </div>
                
                <div class="links">
                    <form method="POST" action="/auth/logout" style="display: inline;">
                        <button type="submit" class="btn btn-primary">Logout Now</button>
                    </form>
                </div>
            </div>
        </div>
    </main>
    
    <script>
        let timeLeft = 10;
        const countdownElement = document.getElementById('countdown');
        
        const timer = setInterval(() => {
            timeLeft--;
            countdownElement.textContent = timeLeft;
            
            if (timeLeft <= 0) {
                clearInterval(timer);
                // Auto logout
                fetch('/auth/logout', { method: 'POST' })
                    .then(() => window.location.href = '/auth/login');
            }
        }, 1000);
    </script>
    
    <%- include('../partials/footer') %>
</body>
</html>
