
<!DOCTYPE html>
<html>
<head>
    <title>Contact Support - Kevin's Corner</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Kevin's Corner</h1>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/support/messages">My Messages</a></li>
            </ul>
        </nav>
        <div style="float: right;">
            Welcome, <%= user.displayname %>! 
            <form method="POST" action="/auth/logout" style="display: inline;">
                <button type="submit" style="background: none; border: none; color: white; cursor: pointer; text-decoration: underline;">Logout</button>
            </form>
        </div>
    </header>

    <main>
        <div class="form-container">
            <h2>Contact Support</h2>
            
            <% if (error) { %>
                <div class="error"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="success"><%= success %></div>
            <% } %>
            
            <form method="POST" action="/support/contact">
                <div class="form-group">
                    <label for="subject">Subject</label>
                    <input type="text" id="subject" name="subject" required>
                </div>
                
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" rows="6" required placeholder="Describe your issue or question..."></textarea>
                </div>
                
                <button type="submit" class="btn">Send Message</button>
            </form>
            
            <div class="links">
                <a href="/">← Back to Home</a>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
