
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify PIN - Message Center - Kevin's Corner</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/header', { user: user }) %>

    <main>
        <div class="form-container">
            <div class="pin-verify-header">
                <h2>🔒 Secure Access Required</h2>
                <p>Please enter your PIN to access the message center</p>
            </div>

            <% if (error) { %>
                <div class="error"><%= error %></div>
            <% } %>

            <form method="POST" action="/messages/verify-pin" class="pin-verify-form">
                <div class="form-group">
                    <label for="pin">Your PIN:</label>
                    <input type="password" 
                           id="pin" 
                           name="pin" 
                           placeholder="Enter your PIN" 
                           required 
                           autocomplete="current-password"
                           maxlength="20">
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        🔓 Verify & Access Messages
                    </button>
                    <a href="/" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <div class="security-info">
                <h4>🛡️ Security Notice</h4>
                <ul>
                    <li>Your PIN verification will remain valid for 1 hour</li>
                    <li>This helps protect your private messages</li>
                    <li>Never share your PIN with anyone</li>
                </ul>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script>
        // Auto-focus the PIN input
        document.getElementById('pin').focus();
        
        // Clear any form data on page load for security
        window.addEventListener('pageshow', function(event) {
            if (event.persisted) {
                document.getElementById('pin').value = '';
            }
        });
    </script>
</body>
</html>
